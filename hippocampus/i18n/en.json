    "desc": {
      "recall": "recall related memories (hybrid by default)",
      "mem help": "show this help (generated from the command table)",
      "mem stats": "store statistics",
      "mem search": "explicit recall mode (dual = two-route RRF with the graph)",
      "mem model": "show current + available models",
      "mem model use embedding": "switch embedding provider",
      "mem model use llm": "switch LLM provider",
      "mem rebuild": "rebuild all embeddings",
      "mem prospective": "list pending prospective triggers",
      "mem session": "show the current session summary / buffer state",
      "mem profile": "view / build the user self-model",
      "mem persona": "view the persona profile",
      "mem activate": "spreading-activation network",
      "mem remember": "write a self-model fact by hand",
      "mem cluster": "show an engram's similar_to cluster",
      "mem cluster-list": "list cluster summaries",
      "mem confidence": "recall with metamemory confidence",
      "mem decaycurve": "forgetting-curve visualisation",
      "mem consolidate": "run consolidation (dedupe/promote/cluster/episodic->semantic)",
      "mem diary": "build yesterday's diary (debug / backfill)",
      "mem forget": "delete an engram (id prefix match)",
      "mem export": "export the store to JSON",
      "mem import": "import from JSON (run /mem rebuild after)",
      "mem graph": "entity + relations + source engrams",
      "mem narrative": "weave an autobiographical narrative on entity/topic",
      "mem debug": "dual-route diagnostic (routes / RRF / MMR)",
      "mem replay": "trigger SWR replay (decay/GC/promote)",
      "mem valence": "emotion valence histogram",
      "mem streams": "what / where+when two-stream breakdown",
      "mem tier": "show hot/warm/cold tiers; reclass recomputes them"
    }
  },
